---
import { content, type Locale } from '../data/content';
import presentation from '../../../docs/design/screenshot-presentation.json';
import ReplayCapture from './ReplayCapture.astro';
import {
  getReplayPaths,
  getReplayPlotPoint,
  replayExample,
} from '../data/replay-example';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = content[locale];
const paths = getReplayPaths();
const finalPoint = getReplayPlotPoint(replayExample.points.at(-1)!);
---

<section id="replay" class="replay chapter content-width">
  <div class="replay-scroll-shell" data-replay-scroll-shell>
    <div class="replay-stage" data-story-stage="replay">
      <div class="section-top chapter-kicker">
        <span class="chapter-number display">{c.replay.number}</span>
        <span class="eyebrow">{c.replay.eyebrow}</span>
      </div>
      <div class="replay-editorial">
        <div class="replay-story">
          <div
            class="replay-introduction stage-heading"
            data-story-item="heading"
            data-story-enter="up"
            data-story-preset="chapter-title"
          >
            <h2>
              {c.replay.title.map((line) => (
                <span data-story-line data-story-reveal>
                  {line}
                </span>
              ))}
            </h2>
            <p class="section-body reading-zone exposed-reading-zone">
              {c.replay.body}
            </p>
          </div>
          <div
            class="replay-analysis"
            data-glass-card
            data-glass-id="replay-analysis"
            data-story-item="visual"
            data-story-enter="left"
            data-story-preset="replay-analysis"
          >
            <div class="replay-insight">
              <figure class="replay-graph" data-replay-graph>
                <figcaption>
                  <div class="replay-graph-source">
                    <small>{c.replay.sampleLabel}</small>
                  </div>
                  <strong class="replay-live-score display">
                    <span data-replay-blue>8</span>
                    <i>:</i>
                    <span data-replay-red>11</span>
                  </strong>
                </figcaption>
                <div class="replay-graph-legend">
                  <span class="graph-blue-key">
                    <i></i>
                    {c.replay.graph.blue}
                  </span>
                  <span class="graph-red-key">
                    <i></i>
                    {c.replay.graph.red}
                  </span>
                  <strong
                    data-replay-event
                    data-opening={c.replay.graph.opening}
                    data-lead={c.replay.graph.lead}
                    data-tie={c.replay.graph.tie}
                    data-turnaround={c.replay.graph.turnaround}
                    data-final={c.replay.graph.final}
                  >
                    {c.replay.graph.final}
                  </strong>
                </div>
                <div class="replay-plot">
                  <svg
                    viewBox="0 0 460 204"
                    role="img"
                    aria-label={c.replay.flowAlt}
                  >
                    <defs>
                      <clipPath id="replay-flow-clip">
                        <rect
                          x="33"
                          y="20"
                          width="398"
                          height="152"
                          data-replay-clip
                        />
                      </clipPath>
                    </defs>
                    <path
                      class="graph-grid"
                      d="M34 28H426M34 74H426M34 120H426M34 166H426"
                    />
                    <g clip-path="url(#replay-flow-clip)">
                      <path class="graph-red" d={paths.right} />
                      <path
                        class="graph-blue"
                        data-example-path
                        d={paths.left}
                      />
                    </g>
                    <g
                      data-replay-cursor
                      transform={`translate(${finalPoint.x} 0)`}
                    >
                      <path class="graph-cursor-line" d="M0 22V170" />
                      <circle
                        class="graph-current-red"
                        cy={finalPoint.rightY}
                        r="4"
                        data-replay-red-dot
                      />
                      <circle
                        class="graph-current-blue"
                        cy={finalPoint.leftY}
                        r="4"
                        data-replay-blue-dot
                      />
                    </g>
                  </svg>
                  <div class="replay-axis" aria-hidden="true">
                    {[12, 8, 4, 0].map((score, index) => (
                      <span
                        class="replay-axis-score"
                        style={`--axis-y: ${((28 + index * 46) / 204) * 100}%`}
                      >
                        {score}
                      </span>
                    ))}
                    <span class="replay-axis-start">0</span>
                    <span class="replay-axis-end">
                      10 {c.replay.graph.rounds}
                    </span>
                  </div>
                </div>
                <div class="replay-moments">
                  {replayExample.keyMoments.slice(0, 3).map((moment, index) => (
                    <div data-replay-moment={moment.id} data-reached="true">
                      <span class="display">0{index + 1}</span>
                      <strong>{c.replay.graph[moment.id]}</strong>
                      <small class="display">
                        {moment.leftScore} : {moment.rightScore}
                      </small>
                    </div>
                  ))}
                </div>
              </figure>
              <div class="replay-analysis-notes reading-zone">
                <p class="replay-example-note">{c.replay.sampleNote}</p>
                <dl class="replay-findings">
                  {c.replay.details.slice(0, 2).map(([title, body]) => (
                    <div>
                      <dt>{title}</dt>
                      <dd>{body}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </div>
        </div>
        {[
          {
            id: 'summary' as const,
            className: 'summary-device replay-summary',
            index: '01',
            title: c.replay.summary,
            note: c.replay.captureResult,
            alt: c.replay.summaryAlt,
            size: presentation.screenshots.summary.extract,
            viewer: c.viewer.summary,
          },
          {
            id: 'history' as const,
            className: 'history-device replay-history',
            index: '02',
            title: c.replay.history,
            note: c.replay.captureNote,
            alt: c.replay.historyAlt,
            size: presentation.screenshots.history.extract,
            viewer: c.viewer.history,
          },
        ].map((item) =>
          item.id === 'history' ? (
            <details
              class="mobile-history-disclosure"
              data-mobile-disclosure="history"
              open
            >
              <summary>
                <span>
                  {locale === 'zh' ? '查看比赛历史' : 'Explore match history'}
                </span>
                <span class="mobile-disclosure-symbol" aria-hidden="true">
                  +
                </span>
              </summary>
              <ReplayCapture locale={locale} {...item} />
            </details>
          ) : (
            <ReplayCapture locale={locale} {...item} />
          ),
        )}
      </div>
    </div>
  </div>
  <p class="fine-print replay-foot">{c.replay.foot}</p>
</section>
