---
import { content, type Locale } from '../data/content';
import presentation from '../../../docs/design/screenshot-presentation.json';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = content[locale];
const size = presentation.screenshots.scoring.extract;
const mobileTitles =
  locale === 'zh'
    ? ['记比分', '标位置', '撤回']
    : ['Score', 'Shot spot', 'Undo'];
const src = `/screenshots/${locale}/scoring.webp`;
const regions = [
  [
    { x: 10, y: 287, width: 287, height: 650, rx: 16 },
    { x: 1518, y: 287, width: 289, height: 650, rx: 16 },
  ],
  [{ x: 529, y: 226, width: 759, height: 709, rx: 5 }],
  [{ x: 646, y: 11, width: 127, height: 126, rx: 20 }],
];
const targets = [
  [
    { x: 155, y: 518 },
    { x: 1662, y: 518 },
  ],
  [{ x: 1050, y: 640 }],
  [{ x: 709, y: 74 }],
];
---

<figure
  class="scoring-display stage-visual"
  data-story-item="visual"
  data-story-enter="right"
  data-story-preset="scoring-screen"
>
  <div class="device-aura" aria-hidden="true"></div>
  <div
    class="landscape-device"
    data-mobile-item="visual"
    data-story-device
    data-score-focus="none"
    data-score-playing="false"
    data-story-reveal
  >
    <span class="device-camera" aria-hidden="true"></span>
    <a
      class="image-link score-screen"
      href={src}
      data-image-viewer
      data-image-title={c.viewer.scoring}
      aria-label={`${c.viewer.open} · ${c.viewer.scoring}`}
    >
      <img
        src={src}
        alt={c.scoring.alt}
        width={size.width}
        height={size.height}
        loading="lazy"
        decoding="async"
        data-desktop-preload
      />
      <svg
        class="score-regions"
        viewBox={`0 0 ${size.width} ${size.height}`}
        aria-hidden="true"
      >
        <defs>
          {regions.map((areas, index) => (
            <mask
              id={`score-focus-${locale}-${index}`}
              maskUnits="userSpaceOnUse"
              x="0"
              y="0"
              width={size.width}
              height={size.height}
              style="mask-type:luminance"
            >
              <rect
                width={size.width}
                height={size.height}
                fill="white"
                stroke="none"
              />
              {areas.map((area) => (
                <rect {...area} fill="black" stroke="none" />
              ))}
            </mask>
          ))}
        </defs>
        {regions.map((areas, index) => (
          <g data-score-region={index}>
            <rect
              class="score-shade"
              width={size.width}
              height={size.height}
              mask={`url(#score-focus-${locale}-${index})`}
            />
            {areas.map((area) => (
              <rect class="score-region-outline" {...area} />
            ))}
          </g>
        ))}
        {targets.map((points, index) => (
          <g data-score-action={index}>
            {points.map((point) => (
              <circle
                class="score-tap-ring"
                data-score-pulse
                cx={point.x}
                cy={point.y}
                r="18"
              />
            ))}
          </g>
        ))}
      </svg>
    </a>
    <span class="device-glass" aria-hidden="true"></span>
  </div>
  <figcaption class="scoring-caption reading-zone exposed-reading-zone">
    <div class="score-caption-meta" data-mobile-item="detail">
      <span class="capture-note">
        <span class="capture-version">{c.scoring.caption.split(' · ')[0]}</span>
        <span class="capture-source">
          {c.scoring.caption.split(' · ').slice(1).join(' · ')}
        </span>
      </span>
      <a
        class="viewer-link"
        href={src}
        data-image-viewer
        data-image-title={c.viewer.scoring}
      >
        {c.viewer.open}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="score-preview" data-score-preview data-mobile-item="detail">
      <p data-score-note>{c.scoring.intro}</p>
      {[c.scoring.intro, ...c.scoring.feedback].map((text) => (
        <span class="score-note-size" aria-hidden="true">
          {text}
        </span>
      ))}
    </div>
  </figcaption>
</figure>
<div class="scoring-control-slot" data-relay-anchor="scoring">
  <div
    class="score-controls"
    data-glass-card
    data-glass-id="scoring-controls"
    data-story-item="control"
    data-story-enter="left"
    data-story-preset="scoring-rail"
    data-score-controls
    data-guide-mode="click"
  >
    <div class="score-guide">
      <span class="score-current" aria-live="polite" aria-atomic="true">
        <span class="display" data-score-step>
          — / 03
        </span>
        <strong class="score-current-name" data-score-current>
          {c.scoring.choose}
        </strong>
      </span>
      <span id="score-guide-hint" class="score-guide-hint">
        {c.scoring.guide.click}
      </span>
    </div>
    <div
      class="score-features"
      role="group"
      aria-label={c.scoring.explore}
      aria-describedby="score-guide-hint"
    >
      {c.scoring.features.map(([title, body], index) => (
        <button
          class="score-feature"
          data-score-feature={index}
          data-score-feedback={c.scoring.feedback[index]}
          data-score-invitation={index === 0 ? 'idle' : undefined}
          aria-pressed="false"
          disabled
        >
          <span class="display feature-index">0{index + 1}</span>
          <span class="score-feature-copy">
            <span class="feature-short-title" aria-hidden="true">
              {mobileTitles[index]}
            </span>
            <strong>{title}</strong>
            <span class="feature-description">{body}</span>
          </span>
          <span class="feature-indicator" aria-hidden="true"></span>
        </button>
      ))}
    </div>
  </div>
</div>
