---
import Layout from './Layout.astro';
import Icon from './Icon.astro';
import { content, type Locale } from '../data/content';
import { release } from '../data/release';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = content[locale];
const home = locale === 'zh' ? '/' : '/en/';
---

<Layout
  locale={locale}
  title={`${c.privacy.title} — ${locale === 'zh' ? '球豆' : 'Hoopito'}`}
  description={c.privacy.subtitle}
  privacy
>
  <header class="site-header">
    <a class="wordmark" href={home} aria-label="Hoopito · 球豆">
      <img src="/brand/mark.webp" alt="" width="40" height="40" />
      <span>HOOPITO.</span>
    </a>
    <a
      class="language"
      href={locale === 'zh' ? '/en/privacy/' : '/privacy/'}
      lang={locale === 'zh' ? 'en' : 'zh-CN'}
    >
      {c.otherLanguage}
    </a>
  </header>
  <main id="main" class="privacy-content content-width">
    <a class="text-link" href={home}>
      <Icon name="arrow" />
      {c.privacy.back}
    </a>
    <p class="eyebrow">YOUR RECORD. YOUR DEVICE.</p>
    <h1>{c.privacy.title}</h1>
    <p class="privacy-subtitle">{c.privacy.subtitle}</p>
    <p class="fine-print">{c.privacy.updated}</p>
    <div class="privacy-sections">
      {c.privacy.sections.map(([heading, body], i) => (
        <section>
          <span class="display">0{i + 1}</span>
          <div>
            <h2>{heading}</h2>
            <p>{body}</p>
          </div>
        </section>
      ))}
    </div>
    <div class="privacy-links">
      <a href="https://vercel.com/legal/privacy-policy">
        {c.privacy.vercel}
        <Icon name="arrow" />
      </a>
      <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">
        {c.privacy.github}
        <Icon name="arrow" />
      </a>
      <a href={release.privacyUrl}>
        {c.privacy.app}
        <Icon name="arrow" />
      </a>
      <a href={release.issuesUrl}>
        {c.privacy.contact}
        <Icon name="arrow" />
      </a>
    </div>
  </main>
  <footer class="privacy-footer content-width">
    <span class="display">HOOPITO.</span>
    <small>© 2026 x1a0Y4NGren</small>
  </footer>
</Layout>
