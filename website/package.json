{
  "name": "hoopito-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && node scripts/prepare-download.mjs && node scripts/check-budget.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "measure:perf": "node scripts/measure-performance.mjs",
    "format:check": "prettier --check src scripts tests *.json *.mjs *.ts *.md",
    "assets": "node scripts/prepare-assets.mjs",
    "export:android-update": "node scripts/export-android-update.mjs"
  },
  "dependencies": {
    "astro": "7.4.0",
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "typescript": "6.0.3"
  }
}
